{% embed '@datainjection/components/mapping_table.html.twig' with {
   form_action: form_action,
   fields_url: fields_url,
   rows: [info],
   title: __('Add an additional information', 'datainjection'),
   icon: 'ti ti-row-insert-bottom',
   switch_label: __('Mandatory information', 'datainjection'),
} %}
   {% block footer %}
      <input type="hidden" name="models_id" value="{{ model_id }}">
      <button type="submit" name="update" value="1" class="btn btn-primary">
         <i class="ti ti-plus me-1"></i>
         <span>{{ _x('button', 'Add') }}</span>
      </button>
   {% endblock %}
{% endembed %}
