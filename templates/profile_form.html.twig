<div class="firstbloc">
   {% if canedit %}
      <form method="post" action="{{ 'Profile'|itemtype_form_path }}">
         <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
         <input type="hidden" name="id" value="{{ profile.fields['id'] }}">
   {% endif %}

   {% do profile.displayRightsChoiceMatrix(rights, {
      'canedit': canedit,
      'default_class': 'tab_bg_2',
      'title': __('General'),
   }) %}

   {% if canedit %}
         <div class="text-center">
            <button type="submit" class="btn btn-primary" name="update" value="1">
               <i class="ti ti-device-floppy"></i>
               <span>{{ _x('button', 'Save') }}</span>
            </button>
         </div>
      </form>
   {% endif %}
</div>
