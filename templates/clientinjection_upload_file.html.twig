{% import 'components/form/fields_macros.html.twig' as fields %}
{% import 'components/form/basic_inputs_macros.html.twig' as inputs %}

{% if add_form %}
    <form method="post" name="form" action="{{ url }}" enctype="multipart/form-data">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}" />
{% endif %}
    <div class="hr-text mt-5 mb-5">
        <i class="fa-2x ti ti-file-arrow-left"></i>
        <span>{{ __('File to inject', 'datainjection') }}</span>
    </div>

    {{ inputs.hidden('id', models_id) }}

    {% set field_options = {
        'field_class': 'col-12',
        'label_class': 'col-sm-4',
        'input_class': 'col-sm-8',
    } %}
    <div class="datainjection-centered-fields mx-auto">
        {{ fields.fileField(
            'filename',
            '',
            __('Choose a file', 'datainjection'),
            field_options|merge({'simple': true})
        ) }}
        {{ fields.dropdownArrayField(
            'file_encoding',
            2,
            file_encoding_values,
            __('File encoding', 'datainjection'),
            field_options
        ) }}
    </div>

    {% set upload_attributes = {} %}
    {% if confirm and (confirm != 'creation' or warn_override) %}
        {% if confirm == 'creation' %}
            {% set message = __('Warning : existing mapped column will be overridden', 'datainjection') %}
        {% else %}
            {% set message = __("Watch out, you're about to inject data into GLPI. Are you sure you want to do it ?", 'datainjection') %}
        {% endif %}
        {% set upload_attributes = {'onclick': "return window.confirm('" ~ message|e('js') ~ "');"} %}
    {% endif %}

    {# In the client injection page, the parent card padding already provides the bottom space #}
    <div class="border-top {{ add_form ? 'py-3' : 'pt-3' }} mt-3 d-flex justify-content-end gap-2">
        <button type="submit" class="btn btn-outline-danger" name="cancel" value="1">
            <i class="ti ti-x me-1"></i>
            <span>{{ _x('button', 'Cancel') }}</span>
        </button>
        <button type="submit" class="btn btn-primary" name="upload" value="1" {{ call('Html::parseAttributes', [upload_attributes])|raw }}>
            <i class="ti ti-upload me-1"></i>
            <span>{{ submit_label }}</span>
        </button>
    </div>
{% if add_form %}
    </form>
{% endif %}