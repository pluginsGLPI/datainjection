{% import 'components/form/basic_inputs_macros.html.twig' as inputs %}

<form method="post" name="form" action="{{ form_action }}">
   {% if show_preview %}
      <div class="mb-3 text-center">
         <a href="#" onclick="var w = window.open('{{ preview_url }}', 'glpipopup', 'height=400, width=600, top=100, left=100, scrollbars=yes'); w.focus(); return false;">
            {{ __('See the file', 'datainjection') }}
         </a>
      </div>
   {% endif %}

   <table class="table table-striped card-table table-hover">
      <thead>
         <tr>
            <th>{{ __('Header of the file', 'datainjection') }}</th>
            <th>{{ __('Tables', 'datainjection') }}</th>
            <th>{{ _n('Field', 'Fields', 2) }}</th>
            <th>{{ __('Link field', 'datainjection') }}</th>
         </tr>
      </thead>
      <tbody>
         {% for mapping in mappings %}
            <tr>
               <td class="text-center">{{ mapping.name }}</td>
               <td class="text-center">{{ mapping.dropdown_html|raw }}</td>
               <td class="text-center"><span id="span_field_{{ mapping.id }}"></span></td>
               <td class="text-center"><span id="span_mandatory_{{ mapping.id }}"></span></td>
            </tr>
         {% endfor %}
      </tbody>
      {% if canedit %}
         <tfoot>
            <tr>
               <td class="text-center" colspan="4">
                  {{ inputs.hidden('models_id', model_id) }}
                  {{ inputs.submit('update', __('Save'), __('Save')) }}
               </td>
            </tr>
         </tfoot>
      {% endif %}
   </table>
</form>

